{
  "name": "overrun-test-harness",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/**/*.test.mjs",
    "test:e2e": "playwright test",
    "test:mp": "node tests/mp/swarm.mjs",
    "lint": "eslint src/**/*.js game.js tests/**/*.mjs scripts/**/*.mjs server/**/*.js",
    "test:ci": "npm run lint && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "cannon-es": "0.20.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "three": "0.169.0",
    "wrangler": "^4.146.0",
    "ws": "^8.22.0"
  }
}
