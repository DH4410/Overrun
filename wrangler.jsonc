// OVERRUN on Cloudflare: static files, one Durable Object room, one Durable Object for accounts. See MULTIPLAYER.md and ACCOUNTS.md.
{
  "name": "overrun",
  "main": "server/worker.js",
  "compatibility_date": "2025-09-01",
  // The browser's files are copied into .cf-public first (see scripts/build-public.mjs).
  "build": { "command": "node scripts/build-public.mjs", "watch_dir": "src" },
  "assets": {
    "directory": ".cf-public",
    "binding": "ASSETS",
    // The room's endpoints must never be answered by the static files.
    "run_worker_first": ["/ws", "/stats", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "GameRoom" }, { "name": "ACCOUNTS", "class_name": "AccountsDO" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountsDO"] }
  ],
  "vars": {
    // Incoming WebSocket messages a day: the free plan's 100,000 requests at 20 messages each.
    "DAILY_MESSAGES": "2000000",
    // Password hashing cost for accounts. A Worker allows at most 100,000; lower it only if sign-ins hit the CPU limit.
    "PBKDF2_ITERATIONS": "100000"
  },
  "observability": { "enabled": true }
}
